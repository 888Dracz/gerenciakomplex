{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@dominio/*": [
        "../server/src/dominio/*"
      ],
      "@backend": [
        "src/local/servidor.ts"
      ]
    },
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src",
    "../server/src/dominio"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "../server/src/**/*.test.ts"
  ]
}
