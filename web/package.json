{
  "name": "@komplex/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:web": "tsc -p tsconfig.json --noEmit && vite build --mode web && node ../scripts/web-final.mjs ../dist-web",
    "preview:web": "vite preview --mode web --outDir ../dist-web"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
